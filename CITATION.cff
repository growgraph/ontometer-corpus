  - family-names: Bareham
    given-names: David
    affiliation: "CESDIP, CY Cergy Paris Université"
    orcid: "https://orcid.org/0009-0000-7542-8966"
repository: "https://github.com/growgraph/ontometer-corpus"
license: CC-BY-4.0
keywords:
